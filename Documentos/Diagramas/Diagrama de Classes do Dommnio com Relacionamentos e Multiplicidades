@startuml

class Usuario {
    +id: int
    +nome: string
    +email: string
    +senha: string
    +cpf: string
    +role: string       // ADMIN ou CLIENTE

    +cadastrarConta()
    +login()
    +editarDados()
}

class Produto {
    +id: int
    +nome: string
    +preco: decimal
    +imagem: string

    +cadastrarProduto()
    +editarProduto()
    +removerProduto()
}

class Carrinho {
    +id: int
    +total: decimal

    +adicionarProduto()
    +removerProduto()
    +calcularTotal()
}

class Pedido {
    +id: int
    +total: decimal
    +status: string

    +finalizarPedido
    +acompanharStatus
}

' ---------------------------
' RELACIONAMENTOS
' ---------------------------

' Usuário cliente possui 1 carrinho
Usuario "1" -- "1" Carrinho : possui

' Carrinho contém 0..* produtos
Carrinho "1" -- "0..*" Produto : contém

' Usuário realiza 0..* pedidos
Usuario "1" -- "0..*" Pedido : realiza

' Pedido contém 1..* produtos
Pedido "1" -- "1..*" Produto : contém

@enduml
